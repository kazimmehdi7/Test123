# ---------- Core ----------
DATABASE_URL=sqlite:///./scoute.db
# Postgres (Docker from docker-compose.yml): postgresql+psycopg://postgres:postgres@localhost:5433/scoute
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# true = seed clearly-labelled DEMO data so you can click through the whole product
#        without scraping. Set to false to use live Amazon / AliExpress data.
SCOUTE_DEMO=true

# ---------- Data sources ----------
AMAZON_ASSOCIATE_TAG=placeholder
PROXY_URL=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
FEED_CATEGORIES=kitchen,home,pet,beauty,fitness,outdoor,office,baby
# Feed build time (UTC). 10 = 6am US Eastern
FEED_HOUR_UTC=10

# ---------- Optional services ----------
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# ---------- Price extraction ----------
# AI tie-breaker runs only when the other 3 methods disagree. Needs OPENAI_API_KEY.
EXTRACT_AI_MODEL=gpt-4o-mini
EXTRACT_AI_MAX_PER_HOUR=60
