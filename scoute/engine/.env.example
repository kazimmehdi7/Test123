# ---------- Core ----------
# SQLite is fine for a single-user local demo only — it serializes all writes, so it will
# throw "database is locked" under any real concurrent load. For anything beyond that,
# run `docker compose up -d postgres` and use the Postgres URL below.
DATABASE_URL=sqlite:///./scoute.db
# Postgres (Docker from docker-compose.yml): postgresql+psycopg://postgres:postgres@localhost:5434/scoute
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# true = seed clearly-labelled DEMO data so you can click through the whole product
#        without scraping. Set to false to use live Amazon / AliExpress data.
SCOUTE_DEMO=true

# ---------- Data sources ----------
AMAZON_ASSOCIATE_TAG=placeholder
PROXY_URL=
# Comma-separated list of proxies to spread the fetch worker pool across (see FETCH_POOL_SIZE
# below). Falls back to PROXY_URL for every worker when unset.
PROXY_URLS=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
FEED_CATEGORIES=kitchen,home,pet,beauty,fitness,outdoor,office,baby
# Feed build time (UTC). 10 = 6am US Eastern
FEED_HOUR_UTC=10

# ---------- Concurrency (see README "Scaling beyond a single machine") ----------
# Browser sessions per scraping profile (stealthy/light/dynamic). Raise together with
# PROXY_URLS — more concurrent requests from one IP gets you blocked faster, not just limited.
FETCH_POOL_SIZE=2
# Threads dispatching user search jobs. The real ceiling is still FETCH_POOL_SIZE above; this
# just stops job dispatch itself from being a second bottleneck stacked on top of that.
INTERACTIVE_WORKERS=3
# Threads dispatching feed/watchlist/Sentinel builds. Leave at 1 unless you understand the
# advisory-lock behavior in app/dlock.py — this is in-process concurrency, a different problem
# from coordinating multiple app *instances* (which the advisory lock handles automatically).
BATCH_WORKERS=1

# ---------- Optional services ----------
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# ---------- Price extraction ----------
# AI tie-breaker runs only when the other 3 methods disagree. Needs OPENAI_API_KEY.
EXTRACT_AI_MODEL=gpt-4o-mini
EXTRACT_AI_MAX_PER_HOUR=60
